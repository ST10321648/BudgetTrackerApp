<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- APP NAME -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Budgeta"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#5C6BC0"
            android:layout_marginBottom="4dp"/>

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monthly Budget Goals"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222"/>

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set your spending limits with Budgeta"
            android:textSize="14sp"
            android:textColor="#777"
            android:layout_marginBottom="12dp"/>

        <!-- BACK BUTTON -->
        <Button
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:backgroundTint="#5C6BC0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <!-- CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- MIN GOAL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minimum Monthly Goal"
                    android:textSize="14sp"
                    android:textColor="#777"/>

                <EditText
                    android:id="@+id/minInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. R1000"
                    android:inputType="numberDecimal"
                    android:padding="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_marginBottom="16dp"/>

                <!-- MAX GOAL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maximum Monthly Goal"
                    android:textSize="14sp"
                    android:textColor="#777"/>

                <EditText
                    android:id="@+id/maxInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. R5000"
                    android:inputType="numberDecimal"
                    android:padding="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_marginBottom="20dp"/>

                <!-- SAVE BUTTON -->
                <Button
                    android:id="@+id/saveGoalBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save Goals"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#5C6BC0"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>