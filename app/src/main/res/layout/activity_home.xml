<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Budget Dashboard"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#222"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track your spending in real time"
            android:textSize="14sp"
            android:textColor="#777"
            android:layout_marginBottom="16dp"/>

        <!-- BUDGET CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvRemainingBudget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R0.00"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remaining Balance"
                    android:textSize="14sp"
                    android:textColor="#777"/>

                <ProgressBar
                    android:id="@+id/budgetProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:progressTint="#2E7D32"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ACTION GRID -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#444"
            android:layout_marginBottom="10dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <!-- CARD BUTTONS -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp">

                <Button
                    android:id="@+id/addCategoryBtn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Add Category"
                    android:textColor="#fff"
                    android:backgroundTint="#5C6BC0"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp">

                <Button
                    android:id="@+id/addExpenseBtn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Add Expense"
                    android:textColor="#fff"
                    android:backgroundTint="#26A69A"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp">

                <Button
                    android:id="@+id/viewExpensesBtn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Expenses"
                    android:textColor="#fff"
                    android:backgroundTint="#FF7043"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp">

                <Button
                    android:id="@+id/setGoalBtn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Set Goals"
                    android:textColor="#fff"
                    android:backgroundTint="#7E57C2"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp">

                <Button
                    android:id="@+id/viewGoalsBtn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Goals"
                    android:textColor="#fff"
                    android:backgroundTint="#42A5F5"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp">

                <Button
                    android:id="@+id/viewCategoryTotalsBtn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Reports"
                    android:textColor="#fff"
                    android:backgroundTint="#66BB6A"/>
            </androidx.cardview.widget.CardView>

        </GridLayout>

    </LinearLayout>
</ScrollView>